# Copy this file to ".env" and fill in your own key. NEVER commit the real .env file.
OPENROUTER_API_KEY=your-openrouter-key-here
# "openrouter/free" lets OpenRouter pick a free model. If tool calling is unreliable with it,
# pin a free model that supports tool calling (see https://openrouter.ai/models?q=free).
OPENROUTER_MODEL=openrouter/free
